# ── Supabase ──────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
REDIS_URL=rediss://:your-password@your-redis-host:6380/0
# Google sign-in (POST /auth/google) has no backend env vars of its own —
# Supabase verifies the Google ID token itself. Enable it in the Supabase
# dashboard: Authentication → Providers → Google, and paste your Google
# Cloud OAuth Client ID(s) (web/iOS/Android) into "Authorized Client IDs".

# ── App ───────────────────────────────────────────────
APP_ENV=development
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# ── External Services ────────────────────────────────
GOOGLE_MAPS_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Instagram (Instagram API with Instagram Login) ───
# App dashboard → Instagram API → API setup with Instagram login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ── Meta parent app ───────────────────────────────────
# App dashboard → App Settings → Basic. Unused for OAuth (that's the
# Instagram App ID/Secret above) — only used to verify the Data Deletion
# Request Callback's signed_request, as a fallback if INSTAGRAM_APP_SECRET
# doesn't verify it (see app/core/meta_signed_request.py).
APP_SECRET=

# ── Token encryption ──────────────────────────────────
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ── S3-Compatible Object Storage (Supabase S3) ───────
# Used by storage_service for presigned upload/download URLs
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=media
AWS_S3_ENDPOINT_URL=https://your-project.storage.supabase.co/storage/v1/s3
