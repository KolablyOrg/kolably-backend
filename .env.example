# ── Supabase ──────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
# Google sign-in (POST /auth/google) has no backend env vars of its own —
# Supabase verifies the Google ID token itself. Enable it in the Supabase
# dashboard: Authentication → Providers → Google, and paste your Google
# Cloud OAuth Client ID(s) (web/iOS/Android) into "Authorized Client IDs".

# ── App ───────────────────────────────────────────────
APP_ENV=development
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# ── External Services ────────────────────────────────
GOOGLE_MAPS_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
